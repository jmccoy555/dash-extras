  <property name="styleSheet">
   <string notr="true">/* Main window / QWidget background */
QWidget {
    background-color: #121212;
    color: #e0e0e0;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    font-size: 13pt;
}

/* QPushButton and QLabel base style */
QPushButton, QLabel {
    background-color: #1e1e1e;
    border: 1.5px solid #3a3a3a;
    border-radius: 5px;
    padding: 6px 12px;
    font-weight: 600;
    color: #e0e0e0;
/*    qproperty-alignment: 'AlignCenter'; */
    min-height: 30px;
}

/* Hover state for buttons */
QPushButton:hover {
    background-color: #272727;
    border-color: #5a5a5a;
}

/* Pressed state for buttons */
QPushButton:pressed {
    background-color: #0f7d15;
    border-color: #07620d;
    color: white;
}

/* Checked (active) state */
QPushButton:checked {
    background-color: #23a825;
    border-color: #1c7e1b;
    color: white;
}

/* Disabled states */
QPushButton:disabled, QLabel:disabled {
    background-color: #2c2c2c;
    border-color: #3a3a3a;
    color: #6a6a6a;
}

/* QLabel specifics to keep look consistent */
QLabel {
    background-color: #1e1e1e;
}
</string>
