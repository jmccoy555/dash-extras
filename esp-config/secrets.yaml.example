# Copy to secrets.yaml (gitignored) alongside defender-main.yaml and fill
# these in for your own setup.
wifi_ssid: "your wifi ssid"
wifi_password: "your wifi password"
hotspot_password: "your fallback AP password"
ota_password: "your OTA update password"
# Only needed if battery-bms.yaml gets enabled (see the warning there) -
# same MAC as dash-gui's victron_secrets.py AUX_BATTERY_BMS_MAC.
bms_mac_address: "XX:XX:XX:XX:XX:XX"
# BLE presence tracking (defender-main.yaml) - iBeacon UUIDs and fob MACs,
# identifying to specific people so kept out of the tracked YAML. Only
# james_* are active by default; olga_* are for the commented-out entries.
james_phone_uuid: "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
james_fob_mac: "XX:XX:XX:XX:XX:XX"
olga_phone_uuid: "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
olga_fob_mac: "XX:XX:XX:XX:XX:XX"
